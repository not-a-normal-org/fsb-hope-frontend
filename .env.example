# ─────────────────────────────────────────────────────────────────────────────
# Saver Miles — environment template
#
# Copy to `.env.local` for local dev (`cp .env.example .env.local`), then fill in
# real values. For Vercel, add every NON-optional key below under
# Project → Settings → Environment Variables for the Production (and Preview)
# environments. `NEXT_PUBLIC_*` values are compiled into the browser bundle;
# never put a secret behind that prefix.
#
# `.env` / `.env.local` are gitignored — never commit real values. This file
# ships only KEYS, no values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Construction wall ────────────────────────────────────────────────────────
# The whole site is gated behind a 503 "under construction" notice UNLESS this
# is exactly "off". Leave unset (or anything but "off") to keep the wall up.
# Set to "off" to go live publicly. See docs/maintenance-mode.md.
MAINTENANCE_MODE=

# Shared-secret password for the /admin portal + the login that lifts the wall
# for you locally (sign in at /admin/login). Required.
ADMIN_SECRET=
# Address the admin portal treats as the super-admin.
ADMIN_EMAIL=

# Public origin of the deployment, e.g. https://savermiles.com (no trailing
# slash). Used to build Stripe redirect URLs and links in transactional email.
# On Vercel set this to the production domain, NOT a *.vercel.app preview URL.
NEXT_PUBLIC_APP_URL=

# ── Supabase (auth + Postgres + Storage) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payload CMS ──────────────────────────────────────────────────────────────
# Random 32+ char string used to sign Payload sessions. Required to boot the CMS.
PAYLOAD_SECRET=
# Postgres connection string — Supabase → Settings → Database → Connection string
# → **Session pooler** (NOT the service_role key). Serverless-safe pooled string.
# Required for both build and runtime.
DATABASE_URI=

# Supabase Storage S3 access keys — Supabase → Storage → S3 Access Keys.
# Media uploads go to the public `media` bucket. Endpoint/region are hardcoded in
# src/payload.config.ts.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint. In production use the
# secret from the LIVE webhook endpoint you register in the Stripe dashboard
# (whsec_…), not the Stripe CLI's local one.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (one-time + subscriptions).
NEXT_PUBLIC_STRIPE_PRICE_EXPLORE=
NEXT_PUBLIC_STRIPE_PRICE_PLATINUM=
NEXT_PUBLIC_STRIPE_PRICE_BLACK=
NEXT_PUBLIC_STRIPE_PRICE_CONCIERGE=
NEXT_PUBLIC_STRIPE_PRICE_RESEARCH=
NEXT_PUBLIC_STRIPE_PRICE_ALERTS_ESSENTIAL_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ALERTS_ESSENTIAL_ANNUAL=
NEXT_PUBLIC_STRIPE_PRICE_ALERTS_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ALERTS_PRO_ANNUAL=
# Alert subscriptions shown on /alerts/weekly + /alerts/human (USD).
# Weekly Lookup: $4.99/mo, $49.90/yr · Human Search: $99.99/mo, $999.90/yr.
NEXT_PUBLIC_STRIPE_PRICE_WEEKLY_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_WEEKLY_ANNUAL=
NEXT_PUBLIC_STRIPE_PRICE_HUMAN_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_HUMAN_ANNUAL=

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=

# ── Cal.com (admin appointments view) — OPTIONAL ─────────────────────────────
# Without CAL_API_KEY the /admin/appointments page shows a "not configured"
# notice instead of pulling bookings. Safe to leave blank.
CAL_API_KEY=
CAL_API_VERSION=
